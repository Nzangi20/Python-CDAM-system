# -----------------------------------------------------------------------------
# Online Examination System - Production Environment Configuration Template
# Copy this file to '.env' in production and update the values below securely.
# -----------------------------------------------------------------------------

# 1. Flask Application Security Key (Generate a strong random string!)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_highly_secure_random_hex_string_in_production

# 2. Database Connection URI
# Format: mysql+pymysql://username:password@hostname:port/database_name
# For local fallback development: mysql+pymysql://root:@localhost:3306/cdam_lms
DATABASE_URL=mysql+pymysql://cdam_user:STRONG_PRODUCTION_PASSWORD@127.0.0.1:3306/cdam_lms

# 3. Flask Runner Directives (Recommended defaults)
FLASK_APP=backend/app.py
FLASK_ENV=production
